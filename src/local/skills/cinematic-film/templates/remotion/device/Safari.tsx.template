import React from 'react';
import { FONT, SCREEN } from './tokens';

// iOS Safari (compact bottom bar): the page between the status bar and a glass toolbar with the domain in a pill.
// `progress` 0..1 draws the load bar along the pill's top edge; `hidden` drops the toolbar (the keyboard is up).
export const SafariBar: React.FC<{ domain: string; progress?: number; hidden?: boolean }> = ({ domain, progress, hidden }) => {
  if (hidden) return null;
  return (
    <div style={{ position: 'absolute', left: 0, top: SCREEN.h - SCREEN.toolbar, width: SCREEN.w, height: SCREEN.toolbar, background: 'rgba(22,22,24,0.94)', borderTop: '0.5px solid rgba(255,255,255,0.08)', zIndex: 30 }}>
      <div style={{ position: 'absolute', left: 12, top: 9, width: 40, height: 40, borderRadius: 20, background: 'rgba(255,255,255,0.08)', display: 'flex', alignItems: 'center', justifyContent: 'center' }}>
        <svg width="12" height="18" viewBox="0 0 12 18" fill="none" stroke="#e5e5ea" strokeWidth="2.2" strokeLinecap="round" strokeLinejoin="round"><path d="M10 2 3 9l7 7" /></svg>
      </div>
      <div style={{ position: 'absolute', left: 60, right: 60, top: 9, height: 40, borderRadius: 20, background: 'rgba(255,255,255,0.1)', overflow: 'hidden', display: 'flex', alignItems: 'center', justifyContent: 'center', gap: 6, color: '#f2f2f7', font: `500 15px ${FONT.ui}` }}>
        <svg width="11" height="14" viewBox="0 0 11 14"><rect x="0.5" y="6" width="10" height="7.5" rx="1.6" fill="#c7c7cc" /><path d="M2.8 6V4.2a2.7 2.7 0 0 1 5.4 0V6" stroke="#c7c7cc" strokeWidth="1.4" fill="none" /></svg>
        {domain}
        {progress !== undefined && progress < 1 && <div style={{ position: 'absolute', left: 0, bottom: 0, height: 2.5, width: `${Math.max(0, progress) * 100}%`, background: '#0a84ff' }} />}
      </div>
      <div style={{ position: 'absolute', right: 12, top: 9, width: 40, height: 40, borderRadius: 20, background: 'rgba(255,255,255,0.08)', display: 'flex', alignItems: 'center', justifyContent: 'center', gap: 3 }}>
        {[0, 1, 2].map((i) => <div key={i} style={{ width: 4.5, height: 4.5, borderRadius: 3, background: '#e5e5ea' }} />)}
      </div>
    </div>
  );
};
