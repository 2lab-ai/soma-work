# Slack App Configuration (Required)
SLACK_BOT_TOKEN=xoxb-your-bot-token
SLACK_APP_TOKEN=xapp-your-app-token

# Optional. Only an HTTP receiver needs this — it verifies the
# X-Slack-Signature header on requests Slack POSTs to a public URL. This bot
# runs Socket Mode (outbound wss keyed by SLACK_APP_TOKEN), so leave it unset.
# If you do set it, it must be at least 20 chars or startup fails.
# SLACK_SIGNING_SECRET=your-signing-secret

# Claude Code Configuration (Optional - only needed if you don't use a Claude subscription)
# ANTHROPIC_API_KEY=your-anthropic-api-key
# CLAUDE_CODE_USE_BEDROCK=1
# CLAUDE_CODE_USE_VERTEX=1

# Auth backend mode (Optional - default: ccp)
#   ccp   : Claude Code Pro/Max OAuth via CCT slot leases (CLAUDE_CODE_OAUTH_TOKEN).
#           Multi-account rotation + /z cct card. Direct API keys managed in the cct store.
#   llmux : route every Agent SDK call at a locally-installed llmux proxy
#           (https://github.com/2lab-ai/llmux). No CCT slot required.
# AUTH_MODE=llmux
# ANTHROPIC_BASE_URL=http://localhost:3456   # llmux default port; the whole integration contract
# ANTHROPIC_API_KEY=anything                 # llmux ignores the value (owns real upstream auth)

# GitHub App Integration (Optional - Recommended for GitHub access)
# GITHUB_APP_ID=123456
# GITHUB_PRIVATE_KEY="-----BEGIN RSA PRIVATE KEY-----\nYour private key content here...\n-----END RSA PRIVATE KEY-----"
# GITHUB_INSTALLATION_ID=12345678

# GitHub Token Integration (Optional - Legacy fallback)
# GITHUB_TOKEN=ghp_your_personal_access_token

# Working Directory Configuration (Required)
# Base directory for user working directories
# Each user gets a fixed directory: {BASE_DIRECTORY}/{userId}/
BASE_DIRECTORY=/Users/username/Code/

# Jira Integration (Optional - for Jira status transitions in session list)
# JIRA_BASE_URL=https://your-org.atlassian.net
# JIRA_EMAIL=your-email@example.com
# JIRA_API_TOKEN=your-jira-api-token

# Release Notification (Optional)
# Channel to post version/release notes on startup
# DEFAULT_UPDATE_CHANNEL=#ai

# Deploy release notes routing (Optional)
# Where the deploy workflow posts release notes (header in the channel, full notes in its thread).
# Entries: owner/repo@branch=<channel> | branch=<channel> | *=session | *=<channel>
# `*=session` keeps unmatched deploys in the deploy session's channel; without `*`
# they stay in the deploy thread. Unset = the deploy session's channel.
# SOMA_RELEASE_NOTES_CHANNELS=acme/app@deploy/dev2=C0123456789,*=session

# Dashboard LLM capacity (Optional)
# llmux does not report subscription plans; map accounts to tiers. The tier weighs each
# account in "max accounts' worth" (x20 = 1, x5 = 0.25, pro500 = 1, pro200 = 0.4).
# Entries: group:name=tier or name=tier; tiers x5 | x20 | pro200 | pro500 (or claude-max-5x ...).
# Built-in defaults: codex:ai1,ai2=pro200 · codex:ai5,ai6=pro500. An unmapped Claude account counts as
# Max x20, shown as an assumption (티어 미지정 N(x20 가정)); an unmapped Codex account stays out of the totals.
# SOMA_LLMUX_ACCOUNT_TIERS=claude:ai7=x20,claude:ai12=x5

# Development Configuration (Optional)
# DEBUG=true

# Dispatch Configuration (Optional)
# Model used for routing messages to workflows (default: claude-haiku-4-5-20251001)
# DISPATCH_MODEL=claude-haiku-4-5-20251001

# Background Agent Keepalive (Optional)
# A turn that launched a background agent stays open until the agent reports
# back, so the agent is not killed when the turn answers. This caps that wait
# in ms: past it the agents are stopped and the turn ends with what it has.
# Default: 1800000 (30 min). 0 disables the keepalive (the turn ends on its
# answer and its background agents stop with it). An invalid or negative value,
# or one above 2147483647, falls back to the default with a warning.
# SOMA_BG_KEEPALIVE_MAX_MS=1800000

# Credential Manager Configuration (Optional)
# Enable local file credentials management (reads ~/.claude/.credentials.json)
# ENABLE_LOCAL_FILE_CREDENTIALS_JSON=1
# AUTOMATIC_RESTORE_CREDENTIAL=1
# CREDENTIAL_ALERT_CHANNEL=#backend-general

# Dashboard Web Server (Optional - for the web dashboard at /dashboard)
# CONVERSATION_VIEWER_TOKEN=your-secret-viewer-token
# Public URL of the dashboard (links, cookies, OAuth callbacks; other hosts 302 to it when https).
# To serve it on your own (intranet) domain see docs/runbook/dashboard-custom-domain.md.
# CONVERSATION_VIEWER_URL=https://your-dashboard-url.example.com
# CONVERSATION_VIEWER_PORT=3000
# CONVERSATION_VIEWER_HOST=127.0.0.1

# Multi-instance dashboard aggregation (#814)
# When two soma-work instances run on the same host (e.g.
# `:33000` + `:33001`), each writes a heartbeat to ~/.soma/instances/<port>.json
# and the dashboard fans out to siblings to merge their kanban boards.
#
# - INSTANCE_NAME: operator-supplied label for the env badge on cards.
#   Falls back to `${hostname}:${port}` when unset, but a human-readable
#   label (oudwood-dev, mac-mini-dev, ...) is what the badge displays.
# - CONVERSATION_VIEWER_TOKEN: cross-port aggregation auth. MUST be the
#   SAME value on every instance that should aggregate together.
#   When unset on either side, that instance silently falls back to
#   self-only with a one-shot warn log.
# - SOMA_INSTANCE_DIR (rare): override the heartbeat directory for tests
#   or non-default deploys. Default: ~/.soma/instances.
#
# INSTANCE_NAME=oudwood-dev
# SOMA_INSTANCE_DIR=/var/lib/soma/instances

# Dashboard OAuth (Optional — enables Google/Microsoft sign-in on the dashboard)
# Requires CONVERSATION_VIEWER_URL to be set for OAuth callback URLs
# SOMA_OAUTH_CALLBACK_BASE_URL overrides the callback origin (default: CONVERSATION_VIEWER_URL) —
# keep a provider-registered old origin while the public URL moves (docs/runbook/dashboard-custom-domain.md).
# SOMA_OAUTH_CALLBACK_BASE_URL=https://old-host.example.net:33443
# The instance checks that CONVERSATION_VIEWER_URL reaches it (startup + every 10 min; result on /health).
# Opt-in: while another server answers there and SOMA_OAUTH_CALLBACK_BASE_URL answers as this instance,
# mint links on SOMA_OAUTH_CALLBACK_BASE_URL until the public URL is fixed (same runbook).
# SOMA_PUBLIC_URL_FALLBACK=true
#
# ── Google OAuth Setup Guide ──
# 1. Go to https://console.cloud.google.com/apis/credentials
# 2. Select or create a project
# 3. Configure OAuth consent screen (APIs & Services > OAuth consent screen)
#    - User Type: Internal (org) or External
#    - Add scopes: openid, email, profile
#    - Add test users if External + unverified
# 4. Create credentials: + CREATE CREDENTIALS > OAuth client ID
#    - Application type: Web application
#    - Authorized redirect URIs: {CONVERSATION_VIEWER_URL}/auth/google/callback
#      e.g. http://localhost:3000/auth/google/callback
# 5. Copy Client ID and Client Secret below
#
# Generate JWT secret: openssl rand -hex 32
#
# GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
# GOOGLE_CLIENT_SECRET=your-google-client-secret
# MICROSOFT_CLIENT_ID=your-microsoft-client-id
# MICROSOFT_CLIENT_SECRET=your-microsoft-client-secret
# DASHBOARD_JWT_SECRET=your-strong-random-secret-here
# DASHBOARD_JWT_EXPIRES_IN=604800
