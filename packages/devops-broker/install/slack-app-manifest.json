{
  "_metadata": {
    "major_version": 1,
    "minor_version": 1
  },
  "display_information": {
    "name": "soma devops approvals",
    "description": "Posts devops approval cards to admins and reads their reactions. Web API only."
  },
  "features": {
    "bot_user": {
      "display_name": "soma-devops-approvals",
      "always_online": false
    }
  },
  "oauth_config": {
    "scopes": {
      "bot": ["chat:write", "im:write", "reactions:read"]
    }
  },
  "settings": {
    "interactivity": {
      "is_enabled": false
    },
    "org_deploy_enabled": false,
    "socket_mode_enabled": false,
    "token_rotation_enabled": false
  }
}
