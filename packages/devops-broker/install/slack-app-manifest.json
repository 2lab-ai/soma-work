{
  "_metadata": {
    "major_version": 1,
    "minor_version": 1
  },
  "display_information": {
    "name": "soma devops approvals",
    "description": "Posts devops approval cards to admins; reads their reactions and approve/deny button clicks (Socket Mode)."
  },
  "features": {
    "bot_user": {
      "display_name": "soma-devops-approvals",
      "always_online": false
    }
  },
  "oauth_config": {
    "scopes": {
      "bot": [
        "chat:write",
        "im:write",
        "reactions:read"
      ]
    }
  },
  "settings": {
    "interactivity": {
      "is_enabled": true
    },
    "org_deploy_enabled": false,
    "socket_mode_enabled": true,
    "token_rotation_enabled": false
  }
}
